{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SidebySide Matching Dataset v2 (Proposal)",
  "description": "A portable dataset bundle. References, ownership, timestamps across records, evidence grounding, and training permissions also require application-level validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "training_basis", "profiles", "posts", "feedback", "training_pairs"],
  "properties": {
    "schema_version": {"const": 2},
    "dataset_id": {"$ref": "#/$defs/id"},
    "training_basis": {"enum": ["synthetic_only", "explicit_opt_in_only", "mixed_authorized"]},
    "profiles": {"type": "array", "items": {"$ref": "#/$defs/profile"}},
    "posts": {"type": "array", "items": {"$ref": "#/$defs/post"}},
    "feedback": {"type": "array", "items": {"$ref": "#/$defs/feedback"}},
    "training_pairs": {"type": "array", "items": {"$ref": "#/$defs/pair"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "nullableText": {"type": ["string", "null"], "minLength": 1},
    "time": {"type": "string", "format": "date-time"},
    "strings": {"type": "array", "items": {"$ref": "#/$defs/text"}, "uniqueItems": true},
    "origin": {"enum": ["synthetic", "real_opt_in"]},
    "judgment": {"enum": ["yes", "no", "unknown"]},
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answer_id", "question_key", "question_text", "answer_text", "answered_at"],
      "properties": {
        "answer_id": {"$ref": "#/$defs/id"},
        "question_key": {"enum": ["interests", "motivation", "goals", "experiences", "open_topics", "conversation_style", "boundaries"]},
        "question_text": {"$ref": "#/$defs/text"},
        "answer_text": {"$ref": "#/$defs/text"},
        "answered_at": {"$ref": "#/$defs/time"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "reference_id", "channel", "support"],
      "properties": {
        "source_type": {"enum": ["onboarding_answer", "owned_post"]},
        "reference_id": {"$ref": "#/$defs/id"},
        "channel": {"enum": ["self_report", "caption", "image"]},
        "support": {"$ref": "#/$defs/text"}
      },
      "allOf": [
        {
          "if": {"properties": {"source_type": {"const": "onboarding_answer"}}, "required": ["source_type"]},
          "then": {"properties": {"channel": {"const": "self_report"}}},
          "else": {"properties": {"channel": {"enum": ["caption", "image"]}}}
        }
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "topic", "relationship", "details", "motivation", "evidence", "confirmation", "matching_allowed", "sharing_scope"],
      "properties": {
        "fact_id": {"$ref": "#/$defs/id"},
        "topic": {"$ref": "#/$defs/text"},
        "relationship": {"enum": ["interested", "experienced", "wants_to_try", "learning", "can_share"]},
        "details": {"$ref": "#/$defs/text"},
        "motivation": {"$ref": "#/$defs/nullableText"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "confirmation": {"enum": ["confirmed", "pending", "rejected"]},
        "matching_allowed": {"type": "boolean"},
        "sharing_scope": {"enum": ["matching_only", "after_mutual_consent"]}
      },
      "allOf": [
        {
          "if": {"properties": {"matching_allowed": {"const": true}}, "required": ["matching_allowed"]},
          "then": {"properties": {"confirmation": {"const": "confirmed"}}}
        },
        {
          "if": {"properties": {"sharing_scope": {"const": "after_mutual_consent"}}, "required": ["sharing_scope"]},
          "then": {"properties": {"confirmation": {"const": "confirmed"}, "matching_allowed": {"const": true}}}
        }
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_version_id", "user_id", "data_origin", "valid_from", "onboarding_answers", "current_goal", "conversation_intent", "facts", "open_to_discussing", "conversation_preferences", "avoid_topics"],
      "properties": {
        "profile_version_id": {"$ref": "#/$defs/id"},
        "user_id": {"$ref": "#/$defs/id"},
        "data_origin": {"$ref": "#/$defs/origin"},
        "valid_from": {"$ref": "#/$defs/time"},
        "onboarding_answers": {"type": "array", "items": {"$ref": "#/$defs/answer"}},
        "current_goal": {"$ref": "#/$defs/nullableText"},
        "conversation_intent": {"$ref": "#/$defs/nullableText"},
        "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "open_to_discussing": {"$ref": "#/$defs/strings"},
        "conversation_preferences": {"$ref": "#/$defs/strings"},
        "avoid_topics": {"$ref": "#/$defs/strings"}
      }
    },
    "post": {
      "type": "object",
      "additionalProperties": false,
      "required": ["post_id", "owner_user_id", "data_origin", "posted_at", "available_at", "caption", "image_ref"],
      "properties": {
        "post_id": {"$ref": "#/$defs/id"},
        "owner_user_id": {"$ref": "#/$defs/id"},
        "data_origin": {"$ref": "#/$defs/origin"},
        "posted_at": {"$ref": "#/$defs/time"},
        "available_at": {"$ref": "#/$defs/time"},
        "caption": {"type": "string"},
        "image_ref": {"$ref": "#/$defs/nullableText", "description": "Private storage reference, not an access token or public profile URL. Null for text-only fixtures."}
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feedback_id", "data_origin", "viewer_profile_version_id", "candidate_profile_version_id", "observed_at", "context", "outcomes", "explicit_comment"],
      "properties": {
        "feedback_id": {"$ref": "#/$defs/id"},
        "data_origin": {"$ref": "#/$defs/origin"},
        "viewer_profile_version_id": {"$ref": "#/$defs/id"},
        "candidate_profile_version_id": {"$ref": "#/$defs/id"},
        "observed_at": {"$ref": "#/$defs/time"},
        "context": {"$ref": "#/$defs/text"},
        "outcomes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["connection_accepted", "conversation_useful", "would_talk_again"],
          "properties": {
            "connection_accepted": {"type": ["boolean", "null"]},
            "conversation_useful": {"type": ["boolean", "null"]},
            "would_talk_again": {"type": ["boolean", "null"]}
          }
        },
        "explicit_comment": {"$ref": "#/$defs/nullableText"}
      }
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relevant_connection", "source", "human_reviewed", "rubric", "reason"],
      "properties": {
        "relevant_connection": {"type": ["integer", "null"], "enum": [0, 1, null]},
        "source": {"enum": ["synthetic_draft", "human_annotation"]},
        "human_reviewed": {"type": "boolean"},
        "rubric": {
          "type": "object",
          "additionalProperties": false,
          "required": ["topic_fit", "intent_fit", "specific_bridge", "evidence_sufficient"],
          "properties": {
            "topic_fit": {"$ref": "#/$defs/judgment"},
            "intent_fit": {"$ref": "#/$defs/judgment"},
            "specific_bridge": {"$ref": "#/$defs/judgment"},
            "evidence_sufficient": {"$ref": "#/$defs/judgment"}
          }
        },
        "reason": {"$ref": "#/$defs/text"}
      },
      "allOf": [
        {
          "if": {"properties": {"source": {"const": "human_annotation"}}, "required": ["source"]},
          "then": {"properties": {"human_reviewed": {"const": true}}}
        },
        {
          "if": {"properties": {"relevant_connection": {"const": 1}}, "required": ["relevant_connection"]},
          "then": {"properties": {"rubric": {"properties": {"topic_fit": {"const": "yes"}, "intent_fit": {"const": "yes"}, "specific_bridge": {"const": "yes"}, "evidence_sufficient": {"const": "yes"}}}}}
        },
        {
          "if": {"properties": {"relevant_connection": {"const": 0}}, "required": ["relevant_connection"]},
          "then": {"properties": {"rubric": {"properties": {"evidence_sufficient": {"const": "yes"}}, "anyOf": [{"properties": {"topic_fit": {"const": "no"}}}, {"properties": {"intent_fit": {"const": "no"}}}, {"properties": {"specific_bridge": {"const": "no"}}}]}}}
        },
        {
          "if": {"properties": {"relevant_connection": {"const": null}}, "required": ["relevant_connection"]},
          "then": {"properties": {"rubric": {"properties": {"evidence_sufficient": {"enum": ["no", "unknown"]}}}}}
        }
      ]
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["example_id", "data_origin", "as_of", "viewer_profile_version_id", "candidate_profile_version_id", "prior_feedback_ids", "context", "label"],
      "properties": {
        "example_id": {"$ref": "#/$defs/id"},
        "data_origin": {"$ref": "#/$defs/origin"},
        "as_of": {"$ref": "#/$defs/time"},
        "viewer_profile_version_id": {"$ref": "#/$defs/id"},
        "candidate_profile_version_id": {"$ref": "#/$defs/id"},
        "prior_feedback_ids": {"$ref": "#/$defs/strings"},
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "goal"],
          "properties": {
            "mode": {"enum": ["learn", "share", "exchange_stories", "collaborate", "find_activity_partner", "casual_chat"]},
            "goal": {"$ref": "#/$defs/nullableText"}
          }
        },
        "label": {"$ref": "#/$defs/label"}
      }
    }
  }
}
