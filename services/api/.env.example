SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SQL migration/verification tools only; the HTTP API uses Supabase REST.
# Use the authorized project's database connection string, or a local test database.
DATABASE_URL=
MUSE_API_KEY=
MUSE_MODEL=muse-spark-1.3
# Fastest supported reasoning mode; none is not supported by Muse Spark.
MUSE_REASONING_EFFORT=minimal
MUSE_ONBOARDING_TIMEOUT_SECONDS=25
MATCHING_EXECUTION=local
MATCHING_PROVIDER=qwen
# Uses the onboarding evidence-v4 pipeline with Qwen + pinned DeBERTa and MiniLM.
# Cache all three checkpoints before starting an inference worker; see docs/api.md.
MATCHING_MODEL_ID=Qwen/Qwen3-Reranker-4B
MATCHING_MODEL_REVISION=22e683669bc0f0bd69640a1354a6d0aebcfeede5
MATCHING_DEVICE=cpu
MATCHING_DTYPE=float32
MATCHING_WARM_ON_STARTUP=false
WORKER_ENABLED=true
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=
SPOTIFY_TOKEN_ENCRYPTION_KEY=
MOBILE_RETURN_URI=sidebyside://settings
# Expo web development origins. Update these if Metro chooses another port.
# Production should list only its own approved HTTPS web origins.
CORS_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081"]
