# Server-only worker configuration. Copy this to worker.env on the pod.
# Never commit the filled file.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

MATCHING_PROVIDER=qwen
MATCHING_MODEL_ID=Qwen/Qwen3-Reranker-4B
MATCHING_MODEL_REVISION=22e683669bc0f0bd69640a1354a6d0aebcfeede5
MATCHING_DEVICE=cuda
MATCHING_DTYPE=float16
MATCHING_EXECUTION=local
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=5
MATCHING_BATCH_SIZE=4

HF_HOME=/workspace/hf-cache
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_DISABLE_IMPLICIT_TOKEN=1
TOKENIZERS_PARALLELISM=false

# Set to 1 only when staging model snapshots on a fresh pod.
DOWNLOAD_MODELS=0
