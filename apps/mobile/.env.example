# These are PUBLIC app settings. Never add a service-role, Muse or Spotify secret here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Browser preview on this computer. Production uses an HTTPS API URL.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
# Optional native-only override: physical phones need your laptop's LAN address.
# Set to http://<your-Mac-LAN-IP>:8000 for local iPhone testing.
EXPO_PUBLIC_NATIVE_API_URL=
